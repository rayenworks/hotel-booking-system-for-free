# Copy this file to .env and fill in YOUR values. NEVER commit .env.

PORT=5000

# development locally, production on your host (hides error details, enables HTTPS-only rules)
NODE_ENV=development

MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/hotel

# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=generate-a-long-random-string

# Only needed ONCE for "npm run seed". Delete ADMIN_PASSWORD from .env afterwards.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password-12+

# Number of proxies in front of the app: 1 on Render/Heroku, 0 on your own computer
TRUST_PROXY=0

# Use Google DNS for the database connection (set false to disable)
USE_PUBLIC_DNS=true
